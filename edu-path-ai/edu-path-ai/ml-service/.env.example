# ---------------------------------------------------------------------------
# ML microservice (FastAPI) environment configuration
# Copy this file to ".env" and fill in real values. Never commit ".env".
# ---------------------------------------------------------------------------

ENVIRONMENT=development
HOST=0.0.0.0
PORT=8001

# Directory where trained model artifacts (classifier.joblib, encoders, etc.)
# are saved by the Phase 8 training pipeline and loaded at inference time.
MODEL_ARTIFACT_DIR=./app/artifacts

# Allowed caller — the Node backend only. This service is internal and
# should not be exposed directly to the public internet in production.
ALLOWED_ORIGIN=http://127.0.0.1:5000

LOG_LEVEL=info
